{
  "name": "player-history-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests *.mjs vitest.config.ts",
    "format": "biome format --write src tests *.mjs vitest.config.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev": "node dev.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.5.0",
    "browser-sync": "^3.0.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "version": "0.0.0-private",
  "dependencies": {
    "preact": "^10.29.8"
  }
}
