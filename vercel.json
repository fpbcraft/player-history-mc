{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix bluemap-addon ci",
  "buildCommand": "npm --prefix bluemap-addon run build",
  "outputDirectory": "bluemap-addon/dist",
  "routes": [
    {
      "src": "/player-history/player-history(?:-[^/]+)?\\.js",
      "dest": "/player-history.js"
    },
    {
      "src": "/player-history/player-history(?:-[^/]+)?\\.css",
      "dest": "/player-history.css"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "https://map.fpbcraft.com/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
